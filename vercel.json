{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/adminexams", "destination": "/exams", "permanent": true },
    { "source": "/adminexams/", "destination": "/exams", "permanent": true },
    { "source": "/adminexams/index.html", "destination": "/exams", "permanent": true },
    { "source": "/lecturerexams", "destination": "/platform/lecturerexams.html", "permanent": true },
    { "source": "/lecturerexams/", "destination": "/platform/lecturerexams.html", "permanent": true },
    { "source": "/lecturerexams/index.html", "destination": "/platform/lecturerexams.html", "permanent": true },
    { "source": "/adminexams/login", "destination": "/examlogin.html", "permanent": true },
    { "source": "/adminexams/login.html", "destination": "/examlogin.html", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/institution-admin",
      "destination": "/platform/institution-admin"
    },
    {
      "source": "/student",
      "destination": "/platform/student"
    },
    {
      "source": "/login",
      "destination": "/platform/login"
    },
    {
      "source": "/exams",
      "destination": "/exams.html"
    },
    {
      "source": "/admin-exams",
      "destination": "/platform/examinations"
    }
  ],
  "headers": [
    {
      "source": "/adminexams",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/adminexams/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/platform/examinations/source/adminexams.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
