{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/examlogin",
      "destination": "/examlogin.html",
      "permanent": true
    },
    {
      "source": "/exams/",
      "destination": "/exams.html",
      "permanent": true
    },
    {
      "source": "/adminexams/",
      "destination": "/platform/examinations/source/adminexams/",
      "permanent": true
    },
    {
      "source": "/adminexams/index.html",
      "destination": "/platform/examinations/source/adminexams/",
      "permanent": true
    },
    {
      "source": "/admin-exams",
      "destination": "/adminexams",
      "permanent": true
    },
    {
      "source": "/admin-exams/",
      "destination": "/adminexams",
      "permanent": true
    },
    {
      "source": "/adminexams/login/",
      "destination": "/examlogin.html",
      "permanent": true
    },
    {
      "source": "/adminexams/login/index.html",
      "destination": "/examlogin.html",
      "permanent": true
    },
    {
      "source": "/examlogin/",
      "destination": "/examlogin.html",
      "permanent": true
    },
    {
      "source": "/examlogin/index.html",
      "destination": "/examlogin.html",
      "permanent": true
    },
    {
      "source": "/lecturerexams",
      "destination": "/platform/lecturerexams/",
      "permanent": true
    },
    {
      "source": "/lecturerexams/",
      "destination": "/platform/lecturerexams/",
      "permanent": true
    },
    {
      "source": "/lecturerexams/index.html",
      "destination": "/platform/lecturerexams.html",
      "permanent": true
    },
    {
      "source": "/adminexams/login",
      "destination": "/examlogin.html",
      "permanent": true
    },
    {
      "source": "/adminexams/login.html",
      "destination": "/examlogin.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/adminexams",
      "destination": "/platform/examinations/source/adminexams/"
    },
    {
      "source": "/adminexams/",
      "destination": "/platform/examinations/source/adminexams/"
    },
    {
      "source": "/adminexams.html",
      "destination": "/platform/examinations/source/adminexams.html"
    },
    {
      "source": "/institution-admin",
      "destination": "/platform/institution-admin"
    },
    {
      "source": "/student",
      "destination": "/platform/student"
    },
    {
      "source": "/login",
      "destination": "/platform/login"
    },
    {
      "source": "/exams",
      "destination": "/exams.html"
    }
  ],
  "headers": [
    {
      "source": "/adminexams",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/adminexams/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/platform/examinations/source/adminexams.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
