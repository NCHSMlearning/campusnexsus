{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/student",
      "destination": "/platform/student"
    },
    {
      "source": "/login",
      "destination": "/platform/login"
    },
    {
      "source": "/exams",
      "destination": "/platform/examinations"
    },
    {
      "source": "/admin-exams",
      "destination": "/platform/examinations"
    }
  ]
}
