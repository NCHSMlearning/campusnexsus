{
  "name": "campus-nexus-secure-exam-browser",
  "version": "0.2.0",
  "private": true,
  "description": "Windows desktop client for Campus Nexus secure examinations",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:strict": "electron . --strict",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:all": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "co.ke.campusnexus.secureexam",
    "productName": "Campus Nexus Secure Exam Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Campus-Nexus-Secure-Exam-Browser-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "protocols": [
      {
        "name": "Campus Nexus Secure Exam Browser",
        "schemes": [
          "campusnexus-seb"
        ]
      }
    ]
  }
}