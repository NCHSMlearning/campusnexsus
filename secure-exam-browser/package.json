{
  "name": "campus-nexus-secure-exam-browser",
  "version": "1.3.1",
  "private": true,
  "description": "Windows desktop client for Campus Nexus secure examinations",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:strict": "electron . --strict",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:all": "electron-builder --win",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "co.ke.campusnexus.secureexam",
    "productName": "Campus Nexus Secure Exam Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/*.ts",
      "!**/*.d.ts",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/campus-nexus.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Campus-Nexus-Secure-Exam-Browser-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "Campus Nexus Secure Exam Browser",
        "schemes": [
          "campusnexus-seb"
        ]
      }
    ],
    "portable": {
      "artifactName": "Campus-Nexus-Secure-Exam-Browser-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NCHSMlearning",
        "repo": "campusnexsus",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
